# Irradiant — Apache config for Hostinger

Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://irradiant.in%{REQUEST_URI} [L,R=301]

# Keep links from the old site (and search results) working
RewriteRule ^abouttechnology-consulting-partnership-india/?$ /about.html [L,R=301]
RewriteRule ^water-energy-telecom-solutions/?$ /services.html [L,R=301]
RewriteRule ^irradiant-systems-privacy-policy/?$ /privacy.html [L,R=301]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>
